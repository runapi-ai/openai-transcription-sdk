{
  "name": "@runapi.ai/openai-transcription",
  "runapi": {
    "slug": "openai-transcription"
  },
  "version": "0.1.0",
  "description": "RunAPI OpenAI Transcription SDK for synchronous speech-to-text integration",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@runapi.ai/core": "^0.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "runapi",
    "runapi-ai",
    "openai",
    "transcription",
    "speech-to-text",
    "audio",
    "api",
    "sdk",
    "typescript",
    "python",
    "ruby",
    "golang",
    "java",
    "maven"
  ],
  "author": "RunAPI",
  "license": "Apache-2.0",
  "homepage": "https://runapi.ai/models/openai-transcription",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runapi-ai/openai-transcription-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/runapi-ai/openai-transcription-sdk/issues"
  }
